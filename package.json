{
  "name": "promptde",
  "version": "0.1.6",
  "private": true,
  "type": "module",
  "main": "desktop/main.mjs",
  "desktopName": "promptde",
  "description": "Voice-to-agent prompt compiler for Hindi, English, and Hinglish.",
  "homepage": "https://promptde.local",
  "author": {
    "name": "PromptDe Contributors",
    "email": "support@promptde.local"
  },
  "scripts": {
    "start": "node server.mjs",
    "desktop": "node desktop/launch.cjs",
    "check": "node --check server.mjs && node --check public/app.js && node --check desktop/main.mjs && node --check desktop/preload.cjs && node --check desktop/launch.cjs && node --check scripts/check-build-environment.mjs && node --check scripts/build-desktop-ci.mjs && node --check test/server.test.mjs",
    "lint": "npm run check",
    "test": "node --test",
    "prepack:linux": "node scripts/check-build-environment.mjs",
    "pack:linux": "electron-builder --linux AppImage deb --publish never",
    "prepack:windows": "node scripts/check-build-environment.mjs",
    "pack:windows": "electron-builder --win nsis --publish never",
    "pack:windows:portable": "electron-builder --win zip --publish never",
    "prepack:mac": "node scripts/check-build-environment.mjs",
    "pack:mac": "electron-builder --mac dmg --x64 --arm64 --publish never"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "electron": "^43.1.1",
    "electron-builder": "26.15.7"
  },
  "build": {
    "appId": "com.promptde.desktop",
    "productName": "PromptDe",
    "asar": true,
    "files": [
      "desktop/**/*",
      "public/**/*",
      "assets/**/*",
      "server.mjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "assets/icon.png",
        "to": "icon.png"
      }
    ],
    "linux": {
      "category": "Utility",
      "icon": "assets/icon.png",
      "maintainer": "PromptDe Contributors <support@promptde.local>",
      "syncDesktopName": true,
      "target": ["AppImage", "deb"]
    },
    "deb": {
      "desktop": {
        "entry": {
          "Icon": "/opt/PromptDe/resources/icon.png"
        }
      }
    },
    "win": {
      "icon": "assets/icon.ico",
      "artifactName": "${productName}-Setup-${arch}.${ext}",
      "target": ["nsis"]
    },
    "mac": {
      "icon": "build/icon.icns",
      "artifactName": "${productName}-mac-${arch}.${ext}",
      "category": "public.app-category.utilities",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "PromptDe uses the microphone to turn your voice into prompts.",
        "NSSpeechRecognitionUsageDescription": "PromptDe uses speech recognition to transcribe spoken prompts."
      },
      "target": ["dmg"]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PromptDe",
      "runAfterFinish": true
    }
  }
}
