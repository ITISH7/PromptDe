# Copy this file to .env and replace the placeholder values.
# Never commit or share your real API keys.

# Required for Hindi / English / Hinglish speech transcription.
GROQ_API_KEY=gsk_your_groq_api_key_here

# Required only when Gemini is selected as the prompt compiler.
# Leave blank if you want to use Groq for both transcription and compilation.
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: change the local server port.
PORT=4173

# Optional: global desktop shortcut for record -> translate -> paste.
PROMPTDE_TRANSLATE_PASTE_SHORTCUT=CommandOrControl+F9
PROMPTDE_QUICK_PROMPT_PASTE_SHORTCUT=Shift+F1
PROMPTDE_STANDARD_PROMPT_PASTE_SHORTCUT=Shift+F2
PROMPTDE_DETAILED_PROMPT_PASTE_SHORTCUT=Shift+F3
